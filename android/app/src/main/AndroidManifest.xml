<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 访问网络（百炼 ASR/LLM、一言 API）：
         ⚠️ debug 构建工具会自动注入 INTERNET 权限，**release 不会**——
         必须显式声明，否则 release 包完全无法访问网络。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 麦克风采集（record 插件也会合并声明，这里显式写出便于审计）。 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 录音期间的前台服务：Android 14+ 起 microphone 类型必须显式声明，
         否则系统会在切后台 / 锁屏时提前掐断麦克风流（表现为「只录一小会儿」）。
         dataSync：终稿转写（上传+轮询）与纪要生成等网络型后台工作托底。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 电池优化白名单请求（切后台不被国产 ROM 强杀的最有效非侵入手段）。 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Android 13+ 前台服务通知需要该权限（否则通知不显示、服务可能起不来）。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- App 内安装更新包（Android 8+ 安装未知应用权限；设置页手动开启）。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 导出写公共 Download（media_store_plus）：API ≤29 需要写权限，30+ 走 MediaStore 零权限。 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <application
        android:label="声羽"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:requestLegacyExternalStorage="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- 保活前台服务：flutter_foreground_task 要求由 App 侧声明（勿改 service name）。
             stopWithTask=false：从最近任务划掉 App 时服务继续存活（录音/转写/生成
             不中断，点通知可回到应用）；true 会在划掉瞬间连带杀服务。 -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="microphone|dataSync"
            android:stopWithTask="false"
            android:exported="false" />
        <!-- App 内安装更新包：暴露 files/updates/ 给系统包安装器（content:// URI）。
             authority 唯一，避免与其它插件声明的 FileProvider 冲突。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.feathernote.app.update.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
